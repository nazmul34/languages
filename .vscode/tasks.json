{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Active C++ File",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build Active C# Project",
            "command": "dotnet",
            "args": [
                "build",
                "${fileDirname}/${fileBasenameNoExtension}.csproj",
                "/property:GenerateFullPaths=true"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}